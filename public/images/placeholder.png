<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f8fafc" />
      <stop offset="100%" stop-color="#f1f5f9" />
    </linearGradient>
    <linearGradient id="screenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2563eb" />
      <stop offset="100%" stop-color="#4f46e5" />
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bgGrad)" rx="16" />
  <g transform="translate(100, 60)">
    <!-- Laptop screen -->
    <rect x="20" y="20" width="160" height="105" rx="8" fill="#0f172a" />
    <rect x="26" y="26" width="148" height="93" rx="4" fill="url(#screenGrad)" opacity="0.95" />
    <!-- Screen graphic -->
    <circle cx="100" cy="72" r="18" fill="white" opacity="0.18" />
    <text x="100" y="77" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="800" fill="#ffffff">D&amp;D.</text>
    <!-- Laptop base -->
    <path d="M5 130 L195 130 L180 142 L20 142 Z" fill="#94a3b8" />
    <rect x="80" y="130" width="40" height="4" rx="2" fill="#cbd5e1" />
  </g>
  <text x="200" y="236" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="800" letter-spacing="-0.3" fill="#0f172a">D&amp;D<tspan fill="#2563eb">.</tspan></text>
</svg>
